{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "translator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl"
          ]
        }
      },
      "required": [
        "provider",
        "resource",
        "version",
        "translator",
        "license",
        "attribution",
        "direction"
      ],
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "properties": {
        "edition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "edition",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "binding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "surah": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 114
                },
                "ayah": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 286
                },
                "word_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "word_end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "surah",
                "ayah",
                "word_start",
                "word_end"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 32
          },
          "arabic_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "source_text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_identity_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          },
          "review_status": {
            "enum": [
              "approved",
              "needs_review"
            ]
          },
          "reviewer": {
            "type": "string",
            "maxLength": 512
          },
          "edited": {
            "type": "boolean"
          },
          "mapping_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "binding_id",
          "revision",
          "spans",
          "arabic_sha256",
          "source_text",
          "source_text_sha256",
          "source_identity_sha256",
          "segments",
          "review_status",
          "reviewer",
          "edited",
          "mapping_revision"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "source",
    "corpus",
    "bindings"
  ],
  "additionalProperties": false
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeyadAbbas/quran-image-generator/blob/main/src/quran_image_generator/assets/schemas/request-v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operation": {
      "enum": [
        "capabilities",
        "preflight",
        "validate",
        "layout",
        "render_batch",
        "translation_catalog",
        "prepare_translations"
      ]
    },
    "source_corpus": {
      "type": "object",
      "properties": {
        "edition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "edition",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "approval": {
          "enum": [
            "approved",
            "needs_review"
          ]
        },
        "styles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "font_size": {
                "type": "number"
              },
              "anchor": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "region": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "direction": {
                "type": "string",
                "maxLength": 64
              },
              "color": {
                "type": "string",
                "maxLength": 64
              },
              "opacity": {
                "type": "number"
              },
              "z_order": {
                "type": "integer"
              },
              "enabled": {
                "type": "boolean"
              },
              "required": {
                "type": "boolean"
              },
              "sha256": {
                "type": "string",
                "maxLength": 64
              },
              "outline_width": {
                "type": "number"
              },
              "outline_color": {
                "type": "string",
                "maxLength": 64
              },
              "shadow_offset": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "shadow_blur": {
                "type": "number"
              },
              "shadow_color": {
                "type": "string",
                "maxLength": 64
              },
              "shadow_opacity": {
                "type": "number"
              },
              "suffix_scale": {
                "type": "number"
              },
              "min_font_size": {
                "type": "integer"
              },
              "max_lines": {
                "type": "integer"
              },
              "line_spacing": {
                "type": "number"
              },
              "baseline_anchor": {
                "type": "string",
                "maxLength": 64
              },
              "fit": {
                "type": "string",
                "maxLength": 64
              },
              "alignment": {
                "type": "string",
                "maxLength": 64
              },
              "safe_margin": {
                "type": "number"
              },
              "quote_open": {
                "type": "string",
                "maxLength": 64
              },
              "quote_close": {
                "type": "string",
                "maxLength": 64
              },
              "numeral_system": {
                "type": "string",
                "maxLength": 64
              },
              "marker_prefix": {
                "type": "string",
                "maxLength": 64
              },
              "marker_suffix": {
                "type": "string",
                "maxLength": 64
              },
              "suffix_spacing": {
                "type": "number"
              },
              "suffix_offset": {
                "type": "number"
              },
              "quote_spacing": {
                "type": "number"
              },
              "horizontal_scale": {
                "type": "number"
              },
              "decoration_scale": {
                "type": "number"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "maxProperties": 16
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "revision",
        "approval",
        "styles",
        "provenance"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "arabic": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license": {
              "type": "string",
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "maxLength": 4096
            },
            "glyph": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "path",
            "sha256",
            "license",
            "attribution"
          ],
          "additionalProperties": false
        },
        "translation": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license": {
              "type": "string",
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "maxLength": 4096
            },
            "glyph": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "path",
            "sha256",
            "license",
            "attribution"
          ],
          "additionalProperties": false
        },
        "arabic_title": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license": {
              "type": "string",
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "maxLength": 4096
            },
            "glyph": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "path",
            "sha256",
            "license",
            "attribution"
          ],
          "additionalProperties": false
        },
        "latin_title": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license": {
              "type": "string",
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "maxLength": 4096
            },
            "glyph": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "path",
            "sha256",
            "license",
            "attribution"
          ],
          "additionalProperties": false
        },
        "logo": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license": {
              "type": "string",
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "maxLength": 4096
            },
            "glyph": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "path",
            "sha256",
            "license",
            "attribution"
          ],
          "additionalProperties": false
        },
        "decorations": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license": {
              "type": "string",
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "maxLength": 4096
            },
            "glyph": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "path",
            "sha256",
            "license",
            "attribution"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "translation_dataset": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "resource": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "translator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "direction": {
              "enum": [
                "ltr",
                "rtl"
              ]
            }
          },
          "required": [
            "provider",
            "resource",
            "version",
            "translator",
            "license",
            "attribution",
            "direction"
          ],
          "additionalProperties": false
        },
        "corpus": {
          "type": "object",
          "properties": {
            "edition": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "edition",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "bindings": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "properties": {
              "binding_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "spans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "surah": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 114
                    },
                    "ayah": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 286
                    },
                    "word_start": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "word_end": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "surah",
                    "ayah",
                    "word_start",
                    "word_end"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 32
              },
              "arabic_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000
              },
              "source_text_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_identity_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "segments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                }
              },
              "review_status": {
                "enum": [
                  "approved",
                  "needs_review"
                ]
              },
              "reviewer": {
                "type": "string",
                "maxLength": 512
              },
              "edited": {
                "type": "boolean"
              },
              "mapping_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "binding_id",
              "revision",
              "spans",
              "arabic_sha256",
              "source_text",
              "source_text_sha256",
              "source_identity_sha256",
              "segments",
              "review_status",
              "reviewer",
              "edited",
              "mapping_revision"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "source",
        "corpus",
        "bindings"
      ],
      "additionalProperties": false
    },
    "translation_resource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "translation_language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "snapshot_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source_attribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "translation_snapshot": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "directory",
        "sha256"
      ],
      "additionalProperties": false
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cue_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "spans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "surah": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 114
                },
                "ayah": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 286
                },
                "word_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "word_end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "surah",
                "ayah",
                "word_start",
                "word_end"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 32
          },
          "translation_policy": {
            "enum": [
              "none",
              "review",
              "required"
            ]
          },
          "translation_binding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "preview_unreviewed_translation": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object"
          },
          "title_surah": {
            "type": "integer",
            "minimum": 1,
            "maximum": 114
          },
          "arabic_title": {
            "type": "string",
            "maxLength": 256
          },
          "latin_title": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "cue_id",
          "spans"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "titles": {
      "type": "boolean"
    },
    "quotations": {
      "type": "boolean"
    },
    "verse_numbers": {
      "type": "boolean"
    },
    "cropped": {
      "type": "boolean"
    },
    "asset_cache_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "deadline_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600
    },
    "output_directory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "error_mode": {
      "enum": [
        "all_or_nothing",
        "per_cue"
      ]
    },
    "require_approved_profile": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "operation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "validate",
              "layout",
              "render_batch"
            ]
          }
        }
      },
      "then": {
        "required": [
          "source_corpus",
          "canvas",
          "cues"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "render_batch"
          }
        }
      },
      "then": {
        "required": [
          "output_directory"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "prepare_translations"
          }
        }
      },
      "then": {
        "required": [
          "source_corpus",
          "cues",
          "translation_resource",
          "snapshot_directory",
          "source_license",
          "source_attribution"
        ]
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeyadAbbas/quran-image-generator/blob/main/src/quran_image_generator/assets/schemas/request-v1.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operation": {
      "enum": [
        "capabilities",
        "preflight",
        "validate",
        "layout",
        "inspect",
        "render_batch",
        "translation_catalog",
        "prepare_translations"
      ]
    },
    "source_corpus": {
      "type": "object",
      "properties": {
        "edition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "edition",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "approval": {
          "enum": [
            "approved",
            "needs_review"
          ]
        },
        "styles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "font_size": {
                "type": "number",
                "default": 30,
                "description": "Font size",
                "minimum": 1,
                "maximum": 256,
                "x-units": "reference_pixels",
                "x-scaling": "canvas_width/576",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text",
                "x-constraints": [
                  "min_font_size <= font_size after resolving omitted defaults"
                ]
              },
              "anchor": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 2,
                "maxItems": 2,
                "default": [
                  0.5,
                  0.5
                ],
                "description": "Normalized x and baseline y in canvas coordinates",
                "x-units": "normalized_canvas",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "layer"
              },
              "region": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 4,
                "maxItems": 4,
                "default": [
                  0.05,
                  0.05,
                  0.95,
                  0.95
                ],
                "description": "Normalized allowed rectangle: left, top, right, bottom",
                "x-units": "normalized_canvas",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "layer",
                "x-constraints": [
                  "left < right",
                  "top < bottom"
                ]
              },
              "direction": {
                "type": "string",
                "maxLength": 64,
                "default": "rtl",
                "description": "Direction",
                "enum": [
                  "rtl",
                  "ltr"
                ],
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "color": {
                "type": "string",
                "maxLength": 64,
                "default": "#FFFFFF",
                "description": "Color",
                "x-format": "opaque_rgb; opacity is a separate field",
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "opacity": {
                "type": "number",
                "default": 1,
                "description": "Opacity",
                "minimum": 0,
                "maximum": 1,
                "x-units": "ratio",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "layer"
              },
              "z_order": {
                "type": "integer",
                "default": 0,
                "description": "Z order",
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "layer"
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Explicitly disabled layers produce no asset",
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "layer"
              },
              "required": {
                "type": "boolean",
                "default": true,
                "description": "Missing content fails when enabled and required",
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "layer"
              },
              "sha256": {
                "type": "string",
                "maxLength": 64,
                "default": "",
                "description": "Optional required primary font or image byte identity",
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "layer"
              },
              "outline_width": {
                "type": "number",
                "default": 0,
                "description": "Outline width",
                "minimum": 0,
                "maximum": 8,
                "x-units": "reference_pixels",
                "x-scaling": "canvas_width/576",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "outline_color": {
                "type": "string",
                "maxLength": 64,
                "default": "#000000",
                "description": "Outline color",
                "x-format": "opaque_rgb; opacity is a separate field",
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "shadow_offset": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -32,
                  "maximum": 32
                },
                "minItems": 2,
                "maxItems": 2,
                "default": [
                  0,
                  0
                ],
                "description": "Shadow offset",
                "x-units": "reference_pixels",
                "x-scaling": "canvas_width/576",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "shadow_blur": {
                "type": "number",
                "default": 0,
                "description": "Shadow blur",
                "minimum": 0,
                "maximum": 16,
                "x-units": "reference_pixels",
                "x-scaling": "canvas_width/576",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "shadow_color": {
                "type": "string",
                "maxLength": 64,
                "default": "#000000",
                "description": "Shadow color",
                "x-format": "opaque_rgb; opacity is a separate field",
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "shadow_opacity": {
                "type": "number",
                "default": 0,
                "description": "Shadow opacity",
                "minimum": 0,
                "maximum": 1,
                "x-units": "ratio",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "suffix_scale": {
                "type": "number",
                "default": 0.55,
                "description": "True verse-end number size relative to fitted body size",
                "minimum": 0.25,
                "maximum": 1,
                "x-units": "ratio",
                "x-scaling": "none",
                "x-roles": [
                  "arabic"
                ],
                "x-applies-to": "text"
              },
              "min_font_size": {
                "type": "integer",
                "default": 12,
                "description": "Min font size",
                "minimum": 1,
                "maximum": 256,
                "x-units": "reference_pixels",
                "x-scaling": "canvas_width/576",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text",
                "x-constraints": [
                  "min_font_size <= font_size after resolving omitted defaults"
                ]
              },
              "max_lines": {
                "type": "integer",
                "default": 3,
                "description": "Max lines",
                "minimum": 1,
                "maximum": 8,
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "line_spacing": {
                "type": "number",
                "default": 8,
                "description": "Extra distance after the largest line ink height; legacy baseline rhythm",
                "minimum": 0,
                "maximum": 64,
                "x-units": "reference_pixels",
                "x-scaling": "canvas_width/576",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "baseline_anchor": {
                "type": "string",
                "maxLength": 64,
                "default": "last",
                "description": "Baseline anchor",
                "enum": [
                  "first",
                  "last"
                ],
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "fit": {
                "type": "string",
                "maxLength": 64,
                "default": "wrap",
                "description": "Fit",
                "enum": [
                  "wrap",
                  "shrink"
                ],
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "alignment": {
                "type": "string",
                "maxLength": 64,
                "default": "center",
                "description": "Alignment",
                "enum": [
                  "left",
                  "center",
                  "right"
                ],
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "safe_margin": {
                "type": "number",
                "default": 0,
                "description": "Safe margin",
                "minimum": 0,
                "maximum": 64,
                "x-units": "reference_pixels",
                "x-scaling": "canvas_width/576",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "layer"
              },
              "quote_open": {
                "type": "string",
                "maxLength": 8,
                "default": "\ufd3f",
                "description": "Quote open",
                "pattern": "^\\S*$",
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic"
                ],
                "x-applies-to": "text"
              },
              "quote_close": {
                "type": "string",
                "maxLength": 8,
                "default": "\ufd3e",
                "description": "Quote close",
                "pattern": "^\\S*$",
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic"
                ],
                "x-applies-to": "text"
              },
              "numeral_system": {
                "type": "string",
                "maxLength": 64,
                "default": "arabic_indic",
                "description": "Numeral system",
                "enum": [
                  "latin",
                  "arabic_indic"
                ],
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic"
                ],
                "x-applies-to": "text"
              },
              "marker_prefix": {
                "type": "string",
                "maxLength": 8,
                "default": "",
                "description": "Marker prefix",
                "pattern": "^\\S*$",
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic"
                ],
                "x-applies-to": "text"
              },
              "marker_suffix": {
                "type": "string",
                "maxLength": 8,
                "default": "",
                "description": "Marker suffix",
                "pattern": "^\\S*$",
                "x-units": "unitless",
                "x-scaling": "none",
                "x-roles": [
                  "arabic"
                ],
                "x-applies-to": "text"
              },
              "suffix_spacing": {
                "type": "number",
                "default": 3,
                "description": "Suffix spacing",
                "minimum": 0,
                "maximum": 32,
                "x-units": "reference_pixels",
                "x-scaling": "canvas_width/576",
                "x-roles": [
                  "arabic"
                ],
                "x-applies-to": "text"
              },
              "suffix_offset": {
                "type": "number",
                "default": 0,
                "description": "Suffix offset",
                "minimum": -32,
                "maximum": 32,
                "x-units": "reference_pixels",
                "x-scaling": "canvas_width/576",
                "x-roles": [
                  "arabic"
                ],
                "x-applies-to": "text"
              },
              "quote_spacing": {
                "type": "number",
                "default": 3,
                "description": "Quote spacing",
                "minimum": 0,
                "maximum": 32,
                "x-units": "reference_pixels",
                "x-scaling": "canvas_width/576",
                "x-roles": [
                  "arabic"
                ],
                "x-applies-to": "text"
              },
              "horizontal_scale": {
                "type": "number",
                "default": 1,
                "description": "Scale the complete shaped line horizontally",
                "minimum": 0.5,
                "maximum": 2,
                "x-units": "ratio",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "decoration_scale": {
                "type": "number",
                "default": 1,
                "description": "Quotation font size relative to fitted body size",
                "minimum": 0.5,
                "maximum": 2,
                "x-units": "ratio",
                "x-scaling": "none",
                "x-roles": [
                  "arabic"
                ],
                "x-applies-to": "text"
              },
              "word_spacing": {
                "type": "number",
                "default": 0,
                "description": "Additional word gap in em of the final fitted font; zero preserves legacy spacing",
                "minimum": 0,
                "maximum": 2,
                "x-units": "em",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text",
                "x-constraints": [
                  "requires native Wand-RAQM for nonzero spacing"
                ]
              },
              "line_height": {
                "type": "number",
                "default": 0,
                "description": "Baseline step in fitted em; zero uses legacy line_spacing",
                "minimum": 0,
                "maximum": 4,
                "x-units": "em",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text"
              },
              "tracking": {
                "type": "number",
                "default": 0,
                "description": "Additional Latin grapheme gap in fitted em; optional cross-grapheme ligatures are disabled",
                "minimum": 0,
                "maximum": 1,
                "x-units": "em",
                "x-scaling": "none",
                "x-roles": [
                  "arabic",
                  "translation",
                  "arabic_title",
                  "latin_title",
                  "logo"
                ],
                "x-applies-to": "text",
                "x-constraints": [
                  "nonzero tracking supports LTR Latin graphemes only",
                  "combining marks remain attached"
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "maxProperties": 16
        },
        "provenance": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "revision",
        "approval",
        "styles",
        "provenance"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "arabic": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license": {
              "type": "string",
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "maxLength": 4096
            },
            "glyph": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "path",
            "sha256",
            "license",
            "attribution"
          ],
          "additionalProperties": false
        },
        "translation": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license": {
              "type": "string",
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "maxLength": 4096
            },
            "glyph": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "path",
            "sha256",
            "license",
            "attribution"
          ],
          "additionalProperties": false
        },
        "arabic_title": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license": {
              "type": "string",
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "maxLength": 4096
            },
            "glyph": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "path",
            "sha256",
            "license",
            "attribution"
          ],
          "additionalProperties": false
        },
        "latin_title": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license": {
              "type": "string",
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "maxLength": 4096
            },
            "glyph": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "path",
            "sha256",
            "license",
            "attribution"
          ],
          "additionalProperties": false
        },
        "logo": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license": {
              "type": "string",
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "maxLength": 4096
            },
            "glyph": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "path",
            "sha256",
            "license",
            "attribution"
          ],
          "additionalProperties": false
        },
        "decorations": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "license": {
              "type": "string",
              "maxLength": 4096
            },
            "attribution": {
              "type": "string",
              "maxLength": 4096
            },
            "glyph": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            }
          },
          "required": [
            "path",
            "sha256",
            "license",
            "attribution"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "translation_dataset": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,

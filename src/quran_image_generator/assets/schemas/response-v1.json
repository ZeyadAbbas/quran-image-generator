{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "renderer_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "needs_review",
        "partial",
        "failed"
      ]
    },
    "corpus": {
      "type": "object"
    },
    "profile": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "capabilities": {
      "type": "object"
    },
    "preflight": {
      "type": "object"
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cue_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "ready",
              "needs_review",
              "failed"
            ]
          },
          "arabic": {
            "type": "string"
          },
          "source_spans": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "object",
                  "properties": {
                    "surah": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 114
                    },
                    "ayah": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 286
                    },
                    "word_start": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "word_end": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "surah",
                    "ayah",
                    "word_start",
                    "word_end"
                  ],
                  "additionalProperties": false
                },
                "text": {
                  "type": "string"
                },
                "target_verse": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "character_start": {
                  "type": "integer",
                  "minimum": 0
                },
                "character_end": {
                  "type": "integer",
                  "minimum": 0
                },
                "starts_ayah": {
                  "type": "boolean"
                },
                "ends_ayah": {
                  "type": "boolean"
                },
                "mapping_revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "target_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "source",
                "text",
                "target_verse",
                "character_start",
                "character_end",
                "starts_ayah",
                "ends_ayah",
                "mapping_revision",
                "target_sha256"
              ],
              "additionalProperties": false
            }
          },
          "translation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "resource": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "translator": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "license": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "attribution": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "direction": {
                        "enum": [
                          "ltr",
                          "rtl"
                        ]
                      }
                    },
                    "required": [
                      "provider",
                      "resource",
                      "version",
                      "translator",
                      "license",
                      "attribution",
                      "direction"
                    ],
                    "additionalProperties": false
                  },
                  "binding": {
                    "type": "object",
                    "properties": {
                      "binding_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "revision": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "spans": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "surah": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 114
                            },
                            "ayah": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 286
                            },
                            "word_start": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "word_end": {
                              "type": "integer",
                              "minimum": 1
                            }
                          },
                          "required": [
                            "surah",
                            "ayah",
                            "word_start",
                            "word_end"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1,
                        "maxItems": 32
                      },
                      "arabic_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "source_text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100000
                      },
                      "source_text_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "source_identity_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "segments": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 32,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8000
                        }
                      },
                      "review_status": {
                        "enum": [
                          "approved",
                          "needs_review"
                        ]
                      },
                      "reviewer": {
                        "type": "string",
                        "maxLength": 512
                      },
                      "edited": {
                        "type": "boolean"
                      },
                      "mapping_revision": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      }
                    },
                    "required": [
                      "binding_id",
                      "revision",
                      "spans",
                      "arabic_sha256",
                      "source_text",
                      "source_text_sha256",
                      "source_identity_sha256",
                      "segments",
                      "review_status",
                      "reviewer",
                      "edited",
                      "mapping_revision"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "source",
                  "binding"
                ],
                "additionalProperties": false
              }
            ]
          },
          "metadata": {
            "type": "object"
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "layer": {
                  "type": "object",
                  "properties": {
                    "font_size": {
                      "type": "integer"
                    },
                    "anchor": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "region": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "direction": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "color": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "opacity": {
                      "type": "number"
                    },
                    "z_order": {
                      "type": "integer"
                    },
                    "enabled": {
                      "type": "boolean"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "sha256": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "outline_width": {
                      "type": "number"
                    },
                    "outline_color": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "shadow_offset": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "shadow_blur": {
                      "type": "number"
                    },
                    "shadow_color": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "shadow_opacity": {
                      "type": "number"
                    },
                    "suffix_scale": {
                      "type": "number"
                    },
                    "min_font_size": {
                      "type": "integer"
                    },
                    "max_lines": {
                      "type": "integer"
                    },
                    "line_spacing": {
                      "type": "number"
                    },
                    "baseline_anchor": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "fit": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "alignment": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "safe_margin": {
                      "type": "number"
                    },
                    "role": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "text": {
                      "type": "string"
                    },
                    "font": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string"
                    },
                    "suffix": {
                      "type": "string"
                    },
                    "persistent": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "font_size",
                    "anchor",
                    "region",
                    "direction",
                    "color",
                    "opacity",
                    "z_order",
                    "enabled",
                    "required",
                    "sha256",
                    "outline_width",
                    "outline_color",
                    "shadow_offset",
                    "shadow_blur",
                    "shadow_color",
                    "shadow_opacity",
                    "suffix_scale",
                    "min_font_size",
                    "max_lines",
                    "line_spacing",
                    "baseline_anchor",
                    "fit",
                    "alignment",
                    "safe_margin",
                    "role",
                    "text",
                    "font",
                    "image",
                    "suffix",
                    "persistent"
                  ],
                  "additionalProperties": false
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "bounds": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "font_size": {
                  "type": "integer",
                  "minimum": 0
                },
                "asset_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "const": ""
                    }
                  ]
                },
                "status": {
                  "enum": [
                    "ready",
                    "disabled",
                    "omitted_optional"
                  ]
                },
                "suffix_position": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "required": [
                "layer",
                "lines",
                "bounds",
                "font_size",
                "asset_sha256",
                "status",
                "suffix_position"
              ],
              "additionalProperties": false
            }
          },
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {
                "type": "object"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "cue_id",
          "status",
          "metadata",
          "warnings",
          "asset_ids"
        ],
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "offset": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "bounds": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "alpha_mode": {
            "const": "straight"
          },
          "color_space": {
            "const": "sRGB"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "persistent": {
            "type": "boolean"
          },
          "effect_bounds": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "anchor": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "font_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "asset_id",
          "path",
          "sha256",
          "width",
          "height",
          "offset",
          "bounds",
          "alpha_mode",
          "color_space",
          "roles",
          "persistent",
          "effect_bounds",
          "anchor",
          "font_sha256"
        ],
        "additionalProperties": false
      }
    },
    "job_directory": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "renderer_version",
    "request_id",
    "status",
    "cues",
    "assets"
  ],
  "additionalProperties": false
}
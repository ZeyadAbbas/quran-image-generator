# Quran Foundation backend-app access:
# https://api-docs.quran.foundation/request-access/
#
# This is a template, not an auto-loaded local environment file. Source runs
# read the process environment only. Docker reads a copied `.env` only when you
# explicitly pass `--env-file .env`. Never commit real values.
#
# New apps start in pre-live. Use production only after that app is approved;
# credentials and tokens are specific to the selected environment.
QF_ENV=prelive
QF_CLIENT_ID=
QF_CLIENT_SECRET=

# Optional Instagram publishing. Keep these blank unless you install the
# `instagram` extra and intentionally use a publish action.
QIG_INSTAGRAM_USERNAME=
QIG_INSTAGRAM_PASSWORD=
